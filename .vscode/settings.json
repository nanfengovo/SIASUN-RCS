{
  "dotnet.unitTests.runSettingsPath": "Siasun.RCS/BackEnd/coverlet.runsettings",
  "csharp.unitTests.runSettingsPath": "Siasun.RCS/BackEnd/coverlet.runsettings",
  "git.autofetch": false,
  "files.watcherExclude": {
