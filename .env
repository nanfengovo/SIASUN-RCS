# ========================================================
# 新松 RCS 调度平台 - Docker Compose 生产环境变量配置
# ========================================================

# 1. Compose 项目名称前缀 (容器和网络以此命名前缀)
COMPOSE_PROJECT_NAME=siasun-rcs

# 2. 外部映射访问端口
FRONTEND_PORT=8080
BACKEND_PORT=9000

# 3. 生产数据库安全凭证 (SQL Server 2022)
DB_USER=sa
DB_PASSWORD=abc,123

# 4. Redis 内存缓存与分布式锁访问密码
REDIS_PASSWORD=abc,123

# 5. 系统时区
TZ=Asia/Shanghai