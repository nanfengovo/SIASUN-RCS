{
  "App": {
    "SelfUrl": "http://localhost:9000",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/log-.txt",
                "rollingInterval": "Day",
                "retainedFileTimeLimit": "90.00:00:00",
                "fileSizeLimitBytes": 104857600,
                "retainedFileCountLimit": 1000,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [T-{ThreadId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/log-.clef",
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
                "rollingInterval": "Day",
                "retainedFileTimeLimit": "90.00:00:00",
                "fileSizeLimitBytes": 104857600,
                "retainedFileCountLimit": 1000
              }
            }
          ]
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "bufferBaseFilename": "Logs/seq-buffer"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "theme": "Serilog.Sinks.SystemConsole.Themes.SystemConsoleTheme::Literate, Serilog.Sinks.Console",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [T-{ThreadId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=SIASUN.RCSCore;User Id=sa;Password=abc,123;Encrypt=True;TrustServerCertificate=True;"
  },
  "AuthServer": {
    "Authority": "http://localhost:9000",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "RCS_Swagger",
    "CertificatePassPhrase": "fd16c88c-cbb7-402d-bbce-2b9683e85a10"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "S46KxOUinrJ9jLYF"
  },
  "AuditLog": {
    "SqlitePath": "Logs/api_audit_log.db"
  },
  "SignalRDiagnostics": {
    "IsEnabled": true,
    "FlushIntervalMs": 150,
    "RingBufferCapacity": 100,
    "MinLogLevel": "Information",
    "AllowAnonymousForLocalNetwork": true,
    "HubEndpoint": "/signalr-hubs/diagnostics"
  }
}